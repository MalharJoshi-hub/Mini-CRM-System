# ==============================================================================
# CRM Platform Environment Configuration Template
# Copy to .env.local for local development
# ==============================================================================

# PostgreSQL Connection String or Discrete Parameters
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/mini_crm
PGUSER=postgres
PGHOST=localhost
PGDATABASE=mini_crm
PGPASSWORD=postgres123
PGPORT=5432

# Connection Pool Tuning
PG_POOL_MAX=20
PG_IDLE_TIMEOUT=30000
PG_CONNECT_TIMEOUT=5000

# JSON Web Token Secret Key
JWT_SECRET=supersecretkey-change-this-in-production

# Nodemailer SMTP Email Dispatcher (Gmail or Custom SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@domain.com
EMAIL_PASS=your_app_password
EMAIL_FROM="CRM Intelligence" <no-reply@domain.com>

# Background Scheduler Frequency (Standard Cron Format)
CRON_SCHEDULE="* * * * *"

# Debug Logging
DEBUG_SQL=false
